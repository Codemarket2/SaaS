{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SST Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "./node_modules/.bin/sst",
      "runtimeArgs": [
        "dev",
        "--increase-timeout",
        "--stage",
        "boossti-backend-lavpreet"
      ],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ]
}
